rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function groupPath(id) { return /databases/$(database)/documents/groups/$(id); }
    function memberPath(id, uid) { return /databases/$(database)/documents/groups/$(id)/members/$(uid); }
    function chunkPath(round, index) { return /databases/$(database)/documents/publicRounds/$(round)/chunks/$(index); }
    function statePath() { return /databases/$(database)/documents/public/state; }
    function member(id) { return signed() && exists(memberPath(id, request.auth.uid)); }
    function endFor(index) { return index == 623 ? 6236 : (index + 1) * 10; }
    // Exclusive end verse for each of the 604 bundled Quran pages, padded to four digits.
    // Generated from assets/quran/verses.json; page p occupies [pageEnd(p-1), pageEnd(p)).
    function pageEnd(page) {
      let ends = ''
                + ''
                + ''
                + ''
                + ''
                + ''
                + '6193620762216236';
      return int(ends[(page - 1) * 4:page * 4]);
    }
    function pageChunkDone(round, index, end) {
      return getAfter(chunkPath(round, index)).data.next >=
        (end < (index + 1) * 10 ? end : (index + 1) * 10);
    }
    function validCompletedPage() {
      let before = resource.data.get('completedPages', []);
      let after = request.resource.data.completedPages;
      let page = request.resource.data.lastCompletedPage;
      let start = page == 1 ? 0 : pageEnd(page - 1);
      let end = pageEnd(page);
      let first = int(start / 10);
      let last = int((end - 1) / 10);
      return page is int && page >= 1 && page <= 604
        && before is list && after is list && !before.hasAny([page])
        && after.size() == before.size() + 1 && after.size() <= 604
        && after.hasAll(before) && after.hasAny([page])
        && pageChunkDone(resource.data.round, first, end)
        && (first + 1 > last || pageChunkDone(resource.data.round, first + 1, end))
        && (first + 2 > last || pageChunkDone(resource.data.round, first + 2, end))
        && (first + 3 > last || pageChunkDone(resource.data.round, first + 3, end))
        && (first + 4 > last || pageChunkDone(resource.data.round, first + 4, end));
    }

    match /users/{uid} {
      allow get: if signed() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'groups'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40 && request.resource.data.groups == []
        && request.resource.data.createdAt == request.time;
      allow update: if signed() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'groups', 'activeRound', 'activeChunk'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.groups is list && request.resource.data.groups.size() <= 30
        && (request.resource.data.keys().hasAll(['activeRound', 'activeChunk']) == false ||
          (request.resource.data.activeRound is int && request.resource.data.activeChunk is int
            && request.resource.data.activeChunk >= 0 && request.resource.data.activeChunk < 624));
      allow delete: if false;
    }

    match /invites/{code} {
      allow get: if signed() && code.matches('^[A-HJ-NP-Z2-9]{16}$');
      allow list, update, delete: if false;
      allow create: if signed() && code.matches('^[A-HJ-NP-Z2-9]{16}$')
        && request.resource.data.keys().hasOnly(['groupId', 'owner'])
        && request.resource.data.owner == request.auth.uid
        && getAfter(groupPath(request.resource.data.groupId)).data.owner == request.auth.uid
        && getAfter(groupPath(request.resource.data.groupId)).data.inviteCode == code;
    }

    match /groups/{id} {
      allow get, list: if member(id);
      allow create: if signed() && request.resource.data.keys().hasOnly([
          'name', 'owner', 'inviteCode', 'round', 'completedHatims', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 70
        && request.resource.data.round == 1 && request.resource.data.completedHatims == 0
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.groupId == id
        && getAfter(memberPath(id, request.auth.uid)).data.uid == request.auth.uid;
      // A group owner may close a round only after its progress document says complete.
      // The completion claim is self-reported; no trusted backend is available on Spark.
      allow update: if signed() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['round', 'completedHatims', 'lastCompletedAt'])
        && request.resource.data.round == resource.data.round + 1
        && request.resource.data.completedHatims == resource.data.completedHatims + 1
        && request.resource.data.lastCompletedAt == request.time;
      allow delete: if false;

      match /members/{uid} {
        allow get: if signed() && (request.auth.uid == uid || member(id));
        allow list: if member(id);
        allow create: if signed() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'joinedAt', 'inviteCode'])
          && request.resource.data.uid == uid
          && request.resource.data.name == get(userPath(uid)).data.name
          && request.resource.data.joinedAt == request.time
          && request.resource.data.inviteCode == getAfter(groupPath(id)).data.inviteCode
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.groupId == id;
        allow update, delete: if false;
      }

      match /rounds/{round}/progress/{document} {
        allow get, list: if member(id);
        allow create: if member(id) && document == 'main'
          && int(round) == get(groupPath(id)).data.round
          && request.resource.data.keys().hasOnly(['marks', 'updatedAt', 'lastKey'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastKey.matches('^(p([1-9]|[1-9][0-9]|[1-5][0-9][0-9]|60[0-4])|j([1-9]|[12][0-9]|30))$')
          && request.resource.data.marks is map
          && request.resource.data.marks.keys().size() == 1
          && request.resource.data.marks[request.resource.data.lastKey].uid == request.auth.uid
          && request.resource.data.marks[request.resource.data.lastKey].name == get(userPath(request.auth.uid)).data.name;
        allow update: if member(id) && document == 'main'
          && int(round) == get(groupPath(id)).data.round
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks', 'updatedAt', 'lastKey'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastKey.matches('^(p([1-9]|[1-9][0-9]|[1-5][0-9][0-9]|60[0-4])|j([1-9]|[12][0-9]|30))$')
          && request.resource.data.marks.keys().size() <= 634
          && request.resource.data.marks.diff(resource.data.marks).affectedKeys().hasOnly([request.resource.data.lastKey])
          && request.resource.data.marks.diff(resource.data.marks).affectedKeys().size() == 1
          && (request.resource.data.marks.keys().hasAny([request.resource.data.lastKey])
            ? (!resource.data.marks.keys().hasAny([request.resource.data.lastKey])
              && request.resource.data.marks[request.resource.data.lastKey].uid == request.auth.uid
              && request.resource.data.marks[request.resource.data.lastKey].name == get(userPath(request.auth.uid)).data.name)
            : (resource.data.marks[request.resource.data.lastKey].uid == request.auth.uid
              || get(groupPath(id)).data.owner == request.auth.uid));
        allow delete: if false;
      }
    }

    match /public/{document} {
      allow get: if signed() && document == 'state';
      allow list, create, delete: if false;
      allow update: if signed() && document == 'state' && (
        // Allocate one never-used chunk, atomically with its creation.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextChunk'])
          && resource.data.nextChunk < 624
          && request.resource.data.nextChunk == resource.data.nextChunk + 1
          && !exists(chunkPath(resource.data.round, resource.data.nextChunk))
          && getAfter(chunkPath(resource.data.round, resource.data.nextChunk)).data.owner == request.auth.uid)
        ||
        // Record a page only when all chunks touching it have confirmed its verses.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedPages', 'lastCompletedPage'])
          && validCompletedPage())
        ||
        // One unique completed chunk increments the round counter.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'completedChunks', 'lastCompletedChunk', 'completedPages', 'lastCompletedPage'])
          && resource.data.completedChunks < 623
          && request.resource.data.completedChunks == resource.data.completedChunks + 1
          && request.resource.data.lastCompletedChunk is int
          && get(chunkPath(resource.data.round, request.resource.data.lastCompletedChunk)).data.next
            == endFor(request.resource.data.lastCompletedChunk) - 1
          && getAfter(chunkPath(resource.data.round, request.resource.data.lastCompletedChunk)).data.next
            == endFor(request.resource.data.lastCompletedChunk)
          && getAfter(chunkPath(resource.data.round, request.resource.data.lastCompletedChunk)).data.owner == request.auth.uid
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'completedPages', 'lastCompletedPage']) || validCompletedPage()))
        ||
        // The 624th unique chunk rolls over exactly once.
        (resource.data.completedChunks == 623 && resource.data.nextChunk == 624
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'round', 'nextChunk', 'completedChunks', 'completedHatims', 'lastCompletedChunk',
            'completedPages', 'lastCompletedPage'])
          && request.resource.data.round == resource.data.round + 1
          && request.resource.data.nextChunk == 0
          && request.resource.data.completedChunks == 0
          && request.resource.data.completedHatims == resource.data.completedHatims + 1
          && request.resource.data.lastCompletedChunk is int
          && request.resource.data.completedPages == []
          && request.resource.data.lastCompletedPage == 0
          && get(chunkPath(resource.data.round, request.resource.data.lastCompletedChunk)).data.next
            == endFor(request.resource.data.lastCompletedChunk) - 1
          && getAfter(chunkPath(resource.data.round, request.resource.data.lastCompletedChunk)).data.next
            == endFor(request.resource.data.lastCompletedChunk)
          && getAfter(chunkPath(resource.data.round, request.resource.data.lastCompletedChunk)).data.owner == request.auth.uid)
      );
    }

    match /publicRounds/{round}/chunks/{index} {
      // Public progress is readable so page completion can inspect adjacent chunks.
      allow get: if signed();
      allow list: if signed() && request.query.limit <= 3;
      allow create: if signed() && int(round) == get(statePath()).data.round
        && int(index) == get(statePath()).data.nextChunk
        && request.resource.data.keys().hasOnly(['index', 'next', 'end', 'owner', 'leaseUntil', 'done'])
        && request.resource.data.index == int(index)
        && request.resource.data.next == int(index) * 10
        && request.resource.data.end == endFor(int(index))
        && request.resource.data.owner == request.auth.uid && request.resource.data.done == false
        && request.resource.data.leaseUntil > request.time
        && request.resource.data.leaseUntil <= request.time + duration.value(31, 'm')
        && getAfter(statePath()).data.nextChunk == int(index) + 1;
      allow update: if signed() && int(round) == get(statePath()).data.round
        && resource.data.done == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'leaseUntil', 'next', 'done'])
        && request.resource.data.leaseUntil > request.time
        && request.resource.data.leaseUntil <= request.time + duration.value(31, 'm')
        && (
          // Expired leases can be reclaimed without changing confirmed progress.
          (resource.data.leaseUntil < request.time
            && request.resource.data.owner == request.auth.uid
            && request.resource.data.next == resource.data.next
            && request.resource.data.done == false)
          ||
          // Only the holder can confirm exactly the next verse.
          (resource.data.owner == request.auth.uid
            && resource.data.leaseUntil >= request.time
            && request.resource.data.owner == resource.data.owner
            && request.resource.data.next == resource.data.next + 1
            && request.resource.data.next <= resource.data.end
            && request.resource.data.done == (request.resource.data.next == resource.data.end)
            && (request.resource.data.done == false
              || getAfter(statePath()).data.round > int(round)
              || getAfter(statePath()).data.completedChunks == get(statePath()).data.completedChunks + 1))
        );
      allow delete: if false;
    }
  }
}
